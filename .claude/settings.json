{
  "_comment": "DBP AI routing (Aixle Insights) — common, committed. Claude Code calls AWS Bedrock. Per-developer SSO. DO NOT PUT YOUR SECRETS HERE.",
  "env": {
    "CLAUDE_CODE_USE_BEDROCK": "1",
    "AWS_PROFILE": "<AWS_PROFILE>",
    "AWS_REGION": "us-east-1",
    "ANTHROPIC_DEFAULT_OPUS_MODEL": "arn:aws:bedrock:us-east-1:<AWS_ACCOUNT_ID>:application-inference-profile/<PROFILE_ID>",
    "ANTHROPIC_DEFAULT_SONNET_MODEL": "arn:aws:bedrock:us-east-1:<AWS_ACCOUNT_ID>:application-inference-profile/<PROFILE_ID>",
    "ANTHROPIC_DEFAULT_HAIKU_MODEL": "arn:aws:bedrock:us-east-1:<AWS_ACCOUNT_ID>:application-inference-profile/<PROFILE_ID>",
    "ANTHROPIC_CUSTOM_HEADERS": "X-Amzn-Bedrock-GuardrailIdentifier: <GUARDRAIL_ID>\nX-Amzn-Bedrock-GuardrailVersion: 1"
  },
  "availableModels": ["opus", "sonnet", "haiku"],
  "awsAuthRefresh": "aws sso login --profile <AWS_PROFILE>",
  "permissions": {
    "allow": [
      "Bash(make lint-api)",
      "Bash(make lint-web)",
      "Bash(make test-api)",
      "Bash(make test-web)",
      "Bash(bundle exec rspec:*)",
      "Bash(bundle exec rubocop:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git status:*)",
      "Bash(npx playwright:*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node --experimental-strip-types --no-warnings ${CLAUDE_PROJECT_DIR}/.claude/hooks/on-edit-lint.ts"
          },
          {
            "type": "command",
            "command": "node --experimental-strip-types --no-warnings ${CLAUDE_PROJECT_DIR}/.claude/hooks/on-aixle-insights-edit.ts"
          },
          {
            "type": "command",
            "command": "sh -c 'f=$CLAUDE_FILE_PATHS; case \"$f\" in *.rb) bundle exec rubocop -a \"$f\" ;; *.ts|*.tsx) npx eslint --fix \"$f\" ;; esac'",
            "description": "Fix lint errors in the edited file"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "context7@claude-plugins-official": true,
    "ruby-lsp@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true,
    "andrej-karpathy-skills@karpathy-skills": true,
    "superpowers@claude-plugins-official": true
  }
}
