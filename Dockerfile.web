# syntax=docker/dockerfile:1
ARG NODE_VERSION=24.13.0
ARG NODE_REGISTRY=ghcr.io/dualboot-partners/db90-rails/node
ARG NGINX_REGISTRY=ghcr.io/dualboot-partners/db90-rails/nginx

FROM ${NODE_REGISTRY}:${NODE_VERSION}-slim AS base

WORKDIR /app

ENV NODE_ENV="production"

# Build stage
FROM base AS build

COPY packages/web/package.json packages/web/package-lock.json packages/web/.npmrc ./
RUN npm ci --include=dev --ignore-scripts

COPY packages/web/ .

RUN npm run build

# CI stage: full Node environment with dev dependencies for tests and linters
FROM base AS ci
ENV NODE_ENV="test"
COPY packages/web/package.json packages/web/package-lock.json packages/web/.npmrc ./
RUN npm ci --include=dev --ignore-scripts
COPY packages/web/ .
CMD ["npm", "run", "test:run"]

# Production stage
FROM ${NGINX_REGISTRY}:alpine AS production

COPY --from=build /app/dist /usr/share/nginx/html

COPY <<'EOF' /etc/nginx/templates/default.conf.template
server {
    listen 80;
    server_name localhost;
    root /usr/share/nginx/html;
    index index.html;

    client_max_body_size 6m;

    resolver 169.254.169.253 valid=10s ipv6=off;

    set $forwarded_proto $http_x_forwarded_proto;
    if ($forwarded_proto = '') {
        set $forwarded_proto $scheme;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }

    location /api {
        set $api_backend "http://${API_UPSTREAM}";
        proxy_pass $api_backend;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $forwarded_proto;
        proxy_cache_bypass $http_upgrade;
    }

    location /admin {
        set $api_backend "http://${API_UPSTREAM}";
        proxy_pass $api_backend;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $forwarded_proto;
    }

    location /cable {
        set $api_backend "http://${API_UPSTREAM}";
        proxy_pass $api_backend;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $forwarded_proto;
    }

    location /up {
        return 200 'ok';
        add_header Content-Type text/plain;
    }

    gzip on;
    gzip_types text/plain text/css application/json application/javascript text/xml application/xml;
}
EOF

ENV API_UPSTREAM="api:3000"
ENV KEYCLOAK_URL=""
ENV KEYCLOAK_REALM="db90"
ENV KEYCLOAK_CLIENT_ID="db90-web"
ENV ROLLBAR_CLIENT_TOKEN=""
ENV SHOW_PROMPT_INSIGHTS_SECTION_IN_PERSONAL_DASHBOARD="false"
# Must be set per deployment target (staging/production). If unset, Rollbar
# silently mislabels the environment as "production" (falls back to the
# Vite build mode) instead of failing loudly like the other vars above.
ENV APP_ENV=""

COPY <<'ENTRYPOINT' /docker-entrypoint.d/90-runtime-config.sh
#!/bin/sh
cat > /usr/share/nginx/html/config.js << EOF
window.__APP_CONFIG__ = {
  keycloakUrl: "${KEYCLOAK_URL}",
  keycloakRealm: "${KEYCLOAK_REALM}",
  keycloakClientId: "${KEYCLOAK_CLIENT_ID}",
  rollbarClientToken: "${ROLLBAR_CLIENT_TOKEN}",
  showPromptInsightsSectionInPersonalDashboard: "${SHOW_PROMPT_INSIGHTS_SECTION_IN_PERSONAL_DASHBOARD}",
  appEnv: "${APP_ENV}"
};
EOF
ENTRYPOINT

RUN chmod +x /docker-entrypoint.d/90-runtime-config.sh

EXPOSE 80

HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
    CMD wget --no-verbose --tries=1 --spider http://localhost/ || exit 1

CMD ["nginx", "-g", "daemon off;"]
