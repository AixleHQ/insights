# syntax=docker/dockerfile:1
ARG RUBY_VERSION=3.4.8
FROM ruby:${RUBY_VERSION}-slim AS base

WORKDIR /app

ENV BUNDLE_DEPLOYMENT="1" \
    BUNDLE_PATH="/usr/local/bundle"

# Build stage
FROM base AS build

RUN apt-get update -qq && \
    apt-get install --no-install-recommends -y \
    build-essential \
    git \
    libyaml-dev \
    pkg-config && \
    rm -rf /var/lib/apt/lists/*

COPY temporal/Gemfile temporal/Gemfile.lock ./
RUN bundle install && \
    rm -rf ~/.bundle/ "${BUNDLE_PATH}"/ruby/*/cache "${BUNDLE_PATH}"/ruby/*/bundler/gems/*/.git

COPY temporal/ .

# Production stage
FROM base

RUN apt-get update -qq && \
    apt-get install --no-install-recommends -y \
    curl \
    libyaml-0-2 && \
    rm -rf /var/lib/apt/lists/*

COPY --from=build "${BUNDLE_PATH}" "${BUNDLE_PATH}"
COPY --from=build /app /app

RUN groupadd --system --gid 1000 temporal && \
    useradd temporal --uid 1000 --gid 1000 --create-home --shell /bin/bash

USER 1000:1000

ENV TEMPORAL_HOST="temporal:7233" \
    TEMPORAL_NAMESPACE="default" \
    TEMPORAL_TASK_QUEUE="db90-tasks"

CMD ["bundle", "exec", "ruby", "workers/ingestion_worker.rb"]
