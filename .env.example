# Google OAuth credentials for Keycloak
# Get these from https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: http://localhost:8080/realms/db90/broker/google-dbp/endpoint
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Atlassian (Jira) OAuth credentials
# Get these from https://developer.atlassian.com/console/myapps/
ATLASSIAN_CLIENT_ID=your-atlassian-client-id
ATLASSIAN_CLIENT_SECRET=your-atlassian-client-secret

# Frontend base URL — used to build OAuth redirect URIs sent to providers (GitHub, GitLab, etc.)
# Must match the actual URL where the frontend is deployed.
# Staging/production example: https://insights.example.com
FRONTEND_URL=http://localhost:5173
