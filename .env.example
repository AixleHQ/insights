# Google OAuth credentials for Keycloak
# Get these from https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: http://localhost:8080/realms/db90/broker/google-dbp/endpoint
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Atlassian (Jira) OAuth credentials
# Get these from https://developer.atlassian.com/console/myapps/
ATLASSIAN_CLIENT_ID=your-atlassian-client-id
ATLASSIAN_CLIENT_SECRET=your-atlassian-client-secret

# Source-control / issue-tracker connector OAuth credentials (optional).
# Only needed for the connectors you enable. See README.md "Connectors" for how to
# register each OAuth app. Leave unset to disable a connector.
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GITLAB_CLIENT_ID=
# GITLAB_CLIENT_SECRET=
# BITBUCKET_CLIENT_ID=
# BITBUCKET_CLIENT_SECRET=
# LINEAR_CLIENT_ID=
# LINEAR_CLIENT_SECRET=

# Frontend base URL — used to build OAuth redirect URIs sent to providers (GitHub, GitLab, etc.)
# Must match the actual URL where the frontend is deployed.
# Staging/production example: https://insights.example.com
FRONTEND_URL=http://localhost:5173

# Data retention — TimescaleDB ceiling
# Sets the global retention ceiling for the tool_events hypertable. TimescaleDB drops
# entire chunks older than this interval. Must be >= the longest org-level
# tool_events_retention window configured in the product (default org max: 730 days / HIPAA).
# The application-level DataRetentionPurgeJob enforces stricter per-org/project limits on top.
MAX_RETENTION_DAYS=720

# Seed control
# Set to 1 on staging to run the heavy simulation seed (100 engineers, ~50k ToolEvents).
# In development the heavy seed always runs regardless of this flag.
# This flag has NO effect in production — the heavy seed is always disabled there.
RUN_HEAVY_SEED=

# OAuth HTTP client timeouts (seconds). Protects Sidekiq workers from hanging
# during provider outages (GitHub, GitLab, Bitbucket, Jira, Linear, etc.).
# Defaults: open_timeout=5, timeout=15.
OAUTH_HTTP_OPEN_TIMEOUT=
OAUTH_HTTP_TIMEOUT=

# TLS / host enforcement — required in production and staging (see production.rb, staging.rb).
# APP_HOST: public hostname of the deployed app (e.g. staging.insights.example.com).
# Base domain is derived automatically (strips leftmost label), so no separate var is needed.
# INTERNAL_API_HOST: Cloud Map / service-discovery hostname used by internal services such as the
# Temporal worker (e.g. api.staging-aixle-db90.local). Leave blank in local dev.
APP_HOST=
INTERNAL_API_HOST=
