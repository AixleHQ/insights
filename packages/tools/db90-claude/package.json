{
  "name": "@db90/claude",
  "version": "0.1.0",
  "description": "CLI tool that reads Claude Code local JSONL transcripts and pushes usage events to db90",
  "type": "module",
  "bin": {
    "db90-claude": "./dist/cli.js"
  },
  "exports": {
    ".": "./dist/cli.js",
    "./sync": {
      "import": "./dist/sync.js",
      "types": "./dist/sync.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/dualboot-partners/db90-rails.git",
    "directory": "packages/tools/db90-claude"
  },
  "homepage": "https://github.com/dualboot-partners/db90-rails/tree/develop/packages/tools/db90-claude#readme",
  "bugs": {
    "url": "https://github.com/dualboot-partners/db90-rails/issues"
  },
  "keywords": [
    "claude-code",
    "claude",
    "ai-usage",
    "analytics",
    "ingest",
    "db90",
    "mcp"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "dev": "tsx src/cli.ts",
    "prepublishOnly": "npm run build",
    "prepack": "node ../scripts/stage-sdk-bundle.mjs"
  },
  "bundledDependencies": [
    "@db90/sdk"
  ],
  "dependencies": {
    "@db90/sdk": "*",
    "glob": "^10.5.0"
  },
  "devDependencies": {
    "@types/node": "^24",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3",
    "vitest": "^1.2.2"
  }
}
