{
  "name": "@db90/telemetry-mcp",
  "version": "0.1.0",
  "description": "stdio MCP server for DB90 — Claude transcript sync, db90_status, db90_sync_now",
  "type": "module",
  "bin": {
    "db90-mcp": "./dist/cli.js"
  },
  "exports": {
    ".": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/dualboot-partners/db90-rails.git",
    "directory": "packages/tools/db90-telemetry-mcp"
  },
  "homepage": "https://github.com/dualboot-partners/db90-rails/tree/develop/packages/tools/db90-telemetry-mcp#readme",
  "bugs": {
    "url": "https://github.com/dualboot-partners/db90-rails/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "claude-code",
    "cursor",
    "db90"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "dev": "tsx src/cli.ts",
    "prepublishOnly": "npm run build",
    "prepack": "node ../scripts/stage-sdk-bundle.mjs"
  },
  "bundledDependencies": [
    "@db90/sdk"
  ],
  "dependencies": {
    "@db90/sdk": "*",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "better-sqlite3": "^12.9.0",
    "glob": "^10.5.0",
    "zod": "^3.23.0 || ^4.0.0"
  },
  "optionalDependencies": {
    "keytar": "^7.9.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.8",
    "@types/node": "^24",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3",
    "vitest": "^1.2.2"
  }
}
