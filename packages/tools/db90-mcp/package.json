{
  "name": "@db90/mcp",
  "version": "0.1.0",
  "description": "MCP server that auto-forwards Claude Code and Cursor usage telemetry to db90",
  "type": "module",
  "bin": {
    "db90-mcp": "./dist/cli.js"
  },
  "exports": {
    ".": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/dualboot-partners/db90-rails.git",
    "directory": "packages/tools/db90-mcp"
  },
  "homepage": "https://github.com/dualboot-partners/db90-rails/tree/develop/packages/tools/db90-mcp#readme",
  "bugs": {
    "url": "https://github.com/dualboot-partners/db90-rails/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "claude-code",
    "cursor",
    "ai-usage",
    "analytics",
    "db90"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "dev": "tsx src/cli.ts",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "keytar": "^7.9.0",
    "zod": "^3.23.0 || ^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^24",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3",
    "vitest": "^1.2.2"
  }
}
