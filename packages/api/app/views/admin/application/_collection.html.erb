<%#
  Collection - Data table for listing resources
  Uses Administrate's collection_presenter (which is page)
%>

<table class="w-full">
  <thead>
    <tr class="border-b border-zinc-200 bg-zinc-50/50">
      <% collection_presenter.attribute_types.each do |attr_name, attr_type| %>
        <th class="px-4 py-3 text-left text-xs font-semibold text-zinc-500 uppercase tracking-wider">
          <%= attr_name.to_s.titleize %>
        </th>
      <% end %>
      <th class="px-4 py-3 text-right text-xs font-semibold text-zinc-500 uppercase tracking-wider">
        Actions
      </th>
    </tr>
  </thead>

  <tbody class="divide-y divide-zinc-100">
    <% resources.each do |resource| %>
      <tr class="hover:bg-zinc-50/50 transition-colors">
        <% collection_presenter.attributes_for(resource).each do |attr| %>
          <td class="px-4 py-3 text-sm text-zinc-700">
            <% if attr.name.to_s == 'id' %>
              <code class="font-mono text-xs text-zinc-500 bg-zinc-100 px-2 py-1 rounded"><%= resource.id %></code>
            <% else %>
              <%= render_field attr %>
            <% end %>
          </td>
        <% end %>
        <td class="px-4 py-3 text-sm text-right">
          <div class="flex items-center justify-end gap-2">
            <% if accessible_action?(resource, :show) %>
              <%= link_to "View",
                  polymorphic_path([namespace, resource]),
                  class: "px-3 py-1.5 text-xs font-medium text-zinc-600 bg-zinc-100 rounded hover:bg-zinc-200 transition-colors" %>
            <% end %>
            <% if accessible_action?(resource, :edit) %>
              <%= link_to "Edit",
                  polymorphic_path([:edit, namespace, resource]),
                  class: "px-3 py-1.5 text-xs font-medium text-zinc-600 bg-zinc-100 rounded hover:bg-zinc-200 transition-colors" %>
            <% end %>
            <% if accessible_action?(resource, :destroy) %>
              <%= link_to "Delete",
                  polymorphic_path([namespace, resource]),
                  method: :delete,
                  data: { confirm: "Are you sure you want to delete this #{collection_presenter.resource_name.titleize}?" },
                  class: "px-3 py-1.5 text-xs font-medium text-red-600 bg-red-50 rounded hover:bg-red-100 transition-colors" %>
            <% end %>
          </div>
        </td>
      </tr>
    <% end %>

    <% if resources.empty? %>
      <tr>
        <td colspan="<%= collection_presenter.attribute_types.count + 1 %>" class="px-4 py-12 text-center">
          <div class="flex flex-col items-center">
            <svg class="w-12 h-12 text-zinc-300 mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M20 13V6a2 2 0 00-2-2H6a2 2 0 00-2 2v7m16 0v5a2 2 0 01-2 2H6a2 2 0 01-2-2v-5m16 0h-2.586a1 1 0 00-.707.293l-2.414 2.414a1 1 0 01-.707.293h-3.172a1 1 0 01-.707-.293l-2.414-2.414A1 1 0 006.586 13H4" />
            </svg>
            <p class="text-sm text-zinc-500">No <%= collection_presenter.resource_name.pluralize %> found</p>
          </div>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>
