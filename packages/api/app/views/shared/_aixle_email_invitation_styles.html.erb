.inviter {
  color: #71717a;
}
.role-badge {
  display: inline-block;
  padding: 4px 12px;
  background-color: #f4f4f5;
  border-radius: 9999px;
  font-size: 14px;
  font-weight: 500;
  color: #52525b;
  text-transform: capitalize;
}
.button {
  display: inline-block;
  padding: 14px 28px;
  background-color: #18181b;
  color: #ffffff !important;
  text-decoration: none;
  border-radius: 8px;
  font-weight: 600;
  font-size: 16px;
  margin: 24px 0;
}
.button:hover {
  background-color: #27272a;
}
.expires {
  font-size: 14px;
  color: #a1a1aa;
  margin-top: 24px;
}
.link {
  color: #3b82f6;
  text-decoration: none;
}
.link:hover {
  text-decoration: underline;
}
