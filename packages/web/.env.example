# Copy this to .env.development for local development

# API URL - use relative path for Vite proxy in development
# In production, set to the full API URL (e.g., https://api.example.com/api/v1)
VITE_API_URL=/api/v1

# Direct API base URL used in shell hook snippets (bypasses the Vite proxy)
# In development: http://localhost:3000
# In production: https://api.example.com (or same as VITE_API_URL base)
VITE_INGEST_BASE_URL=http://localhost:3000

# Admin panel URL — used to redirect back after stopping impersonation
# In development: http://localhost:3000/admin/users
# In production: https://api.example.com/admin/users
VITE_ADMIN_URL=http://localhost:3000/admin/users

# Keycloak Authentication
VITE_KEYCLOAK_URL=http://localhost:8080
VITE_KEYCLOAK_REALM=db90
VITE_KEYCLOAK_CLIENT_ID=db90-web

# E2E test credentials
E2E_TEST_EMAIL=your-name@example.com
E2E_TEST_PASSWORD=your-password
